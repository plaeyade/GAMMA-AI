GAMMA_MINIO_ROOT_PASSWORD=replace-with-local-development-password
GAMMA_S3_ACCESS_KEY_ID=replace-with-local-development-user
GAMMA_S3_SECRET_ACCESS_KEY=replace-with-local-development-password
GAMMA_LOG_LEVEL=INFO
