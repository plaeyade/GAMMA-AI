GAMMA_ENV=development
GAMMA_SERVICE_NAME=gamma-api
GAMMA_POSTGRES_PASSWORD=replace-with-local-development-password
GAMMA_DATABASE_URL=postgresql://gamma:replace-with-local-development-password@localhost:5432/gamma
